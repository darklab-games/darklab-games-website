# ---------------------------------------------------------------
# DarkLab Games — static export served by Apache (Hostinger shared)
# This file is copied into `out/` by `next build` and must sit at the
# root of public_html alongside index.html.
# ---------------------------------------------------------------

# Serve the exported 404 page instead of Apache's default.
ErrorDocument 404 /404.html

# The export uses trailingSlash, so every route is a folder + index.html.
DirectoryIndex index.html
Options -Indexes

# Force HTTPS (Hostinger issues the certificate; this makes it stick).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compression — the JS and HTML shrink a lot, the video does not.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Next.js fingerprints these filenames, so they can be cached forever.
  <IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
  </IfModule>

  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType video/mp4              "access plus 1 year"

  # HTML must revalidate or a redeploy will not reach returning visitors.
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>
